---
import Base from './Base.astro';
import { url } from '../lib/url';

interface Props {
  title: string;
  description: string;
  eyebrow: string;
  badge?: string;
  stack?: string[];
  back: { href: string; label: string };
  /** Shared with the home-page card so the title morphs across the page transition. */
  vtName?: string;
  ogImage?: string;
  date?: Date;
}

const { title, description, eyebrow, badge, stack = [], back, vtName, ogImage, date } = Astro.props;
---

<Base title={title} description={description} ogImage={ogImage} article={{ date }}>
  <main class="gutter">
    <article class="mx-auto flex max-w-[760px] flex-col gap-5 pt-[120px] pb-24">
      <a class="font-mono text-xs text-muted no-underline hover:text-accent" href={url(back.href)}>← {back.label}</a>
      <span class="eyebrow">{eyebrow}</span>
      {badge && <span class="badge">{badge}</span>}
      <h1 class="font-display text-[clamp(34px,5vw,56px)] leading-[1.02] font-extrabold tracking-[-.025em]" style={`font-stretch: 115%;${vtName ? ` view-transition-name: ${vtName}` : ''}`}>{title}</h1>
      <p class="lead text-lg">{description}</p>
      {stack.length > 0 && <div class="chips">{stack.map((s) => <span class="chip">{s}</span>)}</div>}
      <div class="prose-page border-t border-line pt-2">
        <slot />
      </div>
    </article>
  </main>
</Base>
