---
// fonts are self-hosted (no request to Google): Archivo with its width axis, Plex Sans, Plex Mono
import '@fontsource-variable/archivo/wdth.css';
import '@fontsource-variable/ibm-plex-sans';
import '@fontsource/ibm-plex-mono/400.css';
import '@fontsource/ibm-plex-mono/500.css';
import '../styles/global.css';
import 'lenis/dist/lenis.css';
import CommandMenu from '../components/CommandMenu.astro';
import Tldr from '../components/Tldr.astro';
import { profile, services } from '../data/site';
import { url } from '../lib/url';

interface Props {
  title?: string;
  description?: string;
  /** Home page nav links to sections; inner pages link back home. */
  home?: boolean;
  /** Social preview image, relative to the site root (see src/pages/og). */
  ogImage?: string;
}

const { title, description = profile.tagline, home = false, ogImage = 'og/index.png' } = Astro.props;
const pageTitle = title ? `${title} · ${profile.name}` : `${profile.name} · ${profile.headline}`;
const canonical = new URL(Astro.url.pathname, Astro.site);
const ogUrl = new URL(url(ogImage), Astro.site);
const nav = [
  ['Experience', 'experience'],
  ['Platform', 'platform'],
  ['AI', 'ai'],
  ['Skills', 'skills'],
  ['Writing', 'writing'],
  ['Contact', 'contact'],
];
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1, viewport-fit=cover" />
    <title>{pageTitle}</title>
    <meta name="description" content={description} />
    <link rel="canonical" href={canonical} />
    <link rel="icon" type="image/svg+xml" href={url('favicon.svg')} />
    <meta property="og:title" content={pageTitle} />
    <meta property="og:description" content={description} />
    <meta property="og:type" content="website" />
    <meta property="og:url" content={canonical} />
    <meta property="og:image" content={ogUrl} />
    <meta property="og:image:width" content="1200" />
    <meta property="og:image:height" content="630" />
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:image" content={ogUrl} />
    <script is:inline>
      try {
        const t = localStorage.getItem('ss-theme');
        if (t) document.documentElement.dataset.theme = t;
      } catch {}
    </script>
    {services.umamiWebsiteId && <link rel="preconnect" href="https://cloud.umami.is" />}
    {services.umamiWebsiteId && <link rel="preconnect" href="https://gateway.umami.is" />}
    {services.umamiWebsiteId && <script is:inline defer src="https://cloud.umami.is/script.js" data-website-id={services.umamiWebsiteId}></script>}
  </head>
  <body>
    <header class="gutter fixed inset-x-0 z-20" style="top: env(safe-area-inset-top, 0px); background: linear-gradient(var(--bg), transparent)">
      <div class="mx-auto flex h-[60px] max-w-[1280px] items-center gap-4">
        <a class="font-display text-[17px] font-extrabold no-underline" style="font-stretch: 118%" href={home ? '#intro' : url('/')}>{profile.name}</a>
        <nav aria-label="Sections" class="ml-auto hidden gap-4 min-[961px]:flex">
          {nav.map(([label, id]) => (
            <a class="font-mono text-[12.5px] text-muted no-underline hover:text-ink" href={home ? `#${id}` : url(`/#${id}`)}>{label}</a>
          ))}
        </nav>
        <div class="ml-auto flex items-center gap-2 min-[961px]:ml-2">
          <button type="button" data-tldr class="pill">TL;DR</button>
          <button type="button" data-cmdk class="pill" title="Command menu (Ctrl or Cmd + K)"><kbd>⌘K</kbd><span class="sr-only"> command menu</span></button>
          <button id="theme" type="button" title="Switch colour theme" class="pill">Theme</button>
        </div>
      </div>
    </header>
    <slot />
    <CommandMenu />
    <Tldr />
    <script>
      import Lenis from 'lenis';
      import { track, trackRef } from '../lib/analytics';

      const root = document.documentElement;

      /* theme */
      const btn = document.getElementById('theme')!;
      const mq = matchMedia('(prefers-color-scheme: dark)');
      const current = () => root.dataset.theme ?? (mq.matches ? 'dark' : 'light');
      const label = () => { btn.textContent = current() === 'dark' ? 'Light' : 'Dark'; };
      function toggleTheme() {
        const next = current() === 'dark' ? 'light' : 'dark';
        root.dataset.theme = next;
        try { localStorage.setItem('ss-theme', next); } catch {}
        label();
        document.dispatchEvent(new Event('themechange'));
        track('theme', { to: next });
      }
      btn.addEventListener('click', toggleTheme);
      mq.addEventListener('change', label);
      label();

      /* TL;DR dialog */
      const tldr = document.getElementById('tldr') as HTMLDialogElement;
      const openTldr = () => { if (!tldr.open) { tldr.showModal(); track('tldr-open'); } };
      document.querySelectorAll('[data-tldr]').forEach((b) => b.addEventListener('click', openTldr));
      tldr.querySelectorAll('[data-close]').forEach((b) => b.addEventListener('click', () => tldr.close()));
      tldr.addEventListener('click', (e) => { if (e.target === tldr) tldr.close(); });

      /* command menu actions */
      document.addEventListener('cmdk-action', (e) => {
        const action = (e as CustomEvent<string>).detail;
        if (action === 'tldr') openTldr();
        else if (action === 'theme') toggleTheme();
        else if (action === 'copy-email') {
          navigator.clipboard?.writeText('smashysubash@gmail.com').then(() => track('email-copy', { from: 'cmdk' }), () => {});
        }
      });

      /* smooth scrolling; native scrolling when the visitor prefers less motion */
      if (!matchMedia('(prefers-reduced-motion: reduce)').matches) {
        const lenis = new Lenis({ autoRaf: true, anchors: { offset: -20 }, lerp: 0.1 });
        // modals stop the page behind them from scrolling
        for (const d of document.querySelectorAll('dialog')) {
          new MutationObserver(() => (d.open ? lenis.stop() : lenis.start())).observe(d, { attributes: true, attributeFilter: ['open'] });
        }
      }

      trackRef();
    </script>
  </body>
</html>
